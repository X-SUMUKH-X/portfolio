{
  "openapi": "3.1.0",
  "info": {
    "title": "Sumukh Singh Portfolio API",
    "version": "1.0.0",
    "description": "Public REST & MCP API for the Sumukh Singh Portfolio — Creative Strategist & Content Marketer, Delhi, India. Provides structured programmatic access to portfolio data, case studies, service offerings, and verified contact channels.",
    "contact": {
      "name": "Sumukh Singh",
      "email": "sumukh.workk@gmail.com",
      "url": "https://sumukh-portfolio-seven.vercel.app/"
    },
    "license": {
      "name": "Proprietary — read-only access",
      "url": "https://sumukh-portfolio-seven.vercel.app/privacy"
    }
  },
  "externalDocs": {
    "description": "Developer Portal & API Documentation",
    "url": "https://sumukh-portfolio-seven.vercel.app/developers"
  },
  "servers": [
    {
      "url": "https://sumukh-portfolio-seven.vercel.app",
      "description": "Production — v1 (stable)"
    }
  ],
  "tags": [
    { "name": "Portfolio", "description": "Core portfolio information and metadata" },
    { "name": "Work", "description": "Case studies and selected projects" },
    { "name": "Services", "description": "Available creative strategy and marketing services" },
    { "name": "Contact", "description": "Contact methods and direct inquiry channels" },
    { "name": "MCP", "description": "Model Context Protocol (JSON-RPC 2.0) server" }
  ],
  "x-api-version": "1",
  "x-sunset": "2029-08-25",
  "x-deprecation-policy": "https://sumukh-portfolio-seven.vercel.app/developers#deprecation",
  "paths": {
    "/api/v1/info": {
      "get": {
        "operationId": "getPortfolioInfo",
        "summary": "Get complete structured portfolio information",
        "description": "Retrieves comprehensive portfolio information including bio, core skills, selected work case studies, service catalog, and contact details. Supports filtering via the format parameter.",
        "tags": ["Portfolio"],
        "parameters": [
          {
            "name": "format",
            "in": "query",
            "required": false,
            "description": "Filter the response to a specific subset of data.",
            "schema": {
              "type": "string",
              "enum": ["full", "summary", "contact", "work", "services"],
              "default": "full"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Portfolio information retrieved successfully",
            "headers": {
              "X-API-Version": { "schema": { "type": "string" }, "description": "Current API version" },
              "RateLimit-Limit": { "schema": { "type": "integer" }, "description": "Max requests per minute" },
              "RateLimit-Remaining": { "schema": { "type": "integer" }, "description": "Remaining quota" },
              "RateLimit-Reset": { "schema": { "type": "integer" }, "description": "Seconds until reset" },
              "Sunset": { "schema": { "type": "string" }, "description": "API deprecation sunset date" }
            },
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/PortfolioInfo" }
              }
            }
          },
          "400": {
            "description": "Invalid format parameter",
            "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } } }
          },
          "405": {
            "description": "Method not allowed",
            "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } } }
          },
          "429": {
            "description": "Rate limit exceeded",
            "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } } }
          }
        }
      }
    },
    "/api/v1/work": {
      "get": {
        "operationId": "getSelectedWork",
        "summary": "Get selected case studies and projects",
        "description": "Retrieves the list of selected case studies and campaign highlights from Sumukh Singh's portfolio, with optional category filtering.",
        "tags": ["Work"],
        "parameters": [
          {
            "name": "category",
            "in": "query",
            "required": false,
            "description": "Filter projects by category.",
            "schema": {
              "type": "string",
              "enum": ["campaign", "short-form", "analytics", "brand", "ux", "launch"]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Selected work items retrieved successfully",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/WorkResponse" }
              }
            }
          },
          "405": {
            "description": "Method not allowed",
            "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } } }
          }
        }
      }
    },
    "/api/v1/services": {
      "get": {
        "operationId": "getServices",
        "summary": "Get service catalog and offerings",
        "description": "Retrieves the full list of creative strategy, content marketing, branding, and website services offered by Sumukh Singh.",
        "tags": ["Services"],
        "responses": {
          "200": {
            "description": "Service catalog retrieved successfully",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ServicesResponse" }
              }
            }
          },
          "405": {
            "description": "Method not allowed",
            "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } } }
          }
        }
      }
    },
    "/api/v1/contact": {
      "get": {
        "operationId": "getContactInfo",
        "summary": "Get verified contact details and engagement terms",
        "description": "Retrieves verified direct contact email, location, availability status, and consultation terms.",
        "tags": ["Contact"],
        "responses": {
          "200": {
            "description": "Contact information retrieved successfully",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ContactResponse" }
              }
            }
          },
          "405": {
            "description": "Method not allowed",
            "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } } }
          }
        }
      }
    },
    "/api/mcp": {
      "get": {
        "operationId": "getMcpManifest",
        "summary": "Get MCP server discovery manifest",
        "description": "Returns the Model Context Protocol (MCP 2025-03-26) server manifest declaring capabilities, resources, and available tools.",
        "tags": ["MCP"],
        "responses": {
          "200": {
            "description": "MCP discovery manifest",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/McpManifest" }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "postMcpRpc",
        "summary": "Execute MCP JSON-RPC 2.0 requests",
        "description": "Executes MCP protocol methods including initialize, ping, resources/list, resources/read, tools/list, and tools/call.",
        "tags": ["MCP"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/JsonRpcRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "JSON-RPC response",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/JsonRpcResponse" }
              }
            }
          },
          "400": {
            "description": "Invalid JSON or RPC structure",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/JsonRpcErrorResponse" }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Problem": {
        "type": "object",
        "description": "RFC 9457 Problem Details object with machine-readable error codes and resolution hints",
        "required": ["type", "title", "status", "detail", "code", "resolution"],
        "properties": {
          "type": { "type": "string", "format": "uri", "description": "URI identifying the problem type" },
          "title": { "type": "string", "description": "Short summary of the problem" },
          "status": { "type": "integer", "description": "HTTP status code" },
          "detail": { "type": "string", "description": "Detailed human-readable explanation" },
          "code": { "type": "string", "description": "Machine-readable error code" },
          "resolution": { "type": "string", "description": "Actionable resolution hint" },
          "error": {
            "type": "object",
            "properties": {
              "code": { "type": "string" },
              "message": { "type": "string" },
              "resolution": { "type": "string" },
              "resolution_hints": { "type": "array", "items": { "type": "string" } }
            }
          }
        }
      },
      "PersonInfo": {
        "type": "object",
        "required": ["name", "role", "location", "email", "website"],
        "properties": {
          "name": { "type": "string", "example": "Sumukh Singh" },
          "role": { "type": "string", "example": "Creative Strategist & Content Marketer" },
          "location": { "type": "string", "example": "Delhi, India" },
          "email": { "type": "string", "format": "email", "example": "sumukh.workk@gmail.com" },
          "website": { "type": "string", "format": "uri", "example": "https://sumukh-portfolio-seven.vercel.app" },
          "github": { "type": "string", "format": "uri", "example": "https://github.com/X-SUMUKH-X" },
          "availability": { "type": "string", "example": "Open to freelance and consulting engagements" },
          "summary": { "type": "string" }
        }
      },
      "WorkItem": {
        "type": "object",
        "required": ["id", "project", "category", "result", "description"],
        "properties": {
          "id": { "type": "string", "example": "01" },
          "project": { "type": "string", "example": "Fokus App Short-Form System" },
          "category": { "type": "string", "enum": ["campaign", "short-form", "analytics", "brand", "ux", "launch"] },
          "result": { "type": "string", "example": "2.1M views in 24 hours" },
          "description": { "type": "string" }
        }
      },
      "WorkResponse": {
        "type": "object",
        "required": ["selectedWork", "total"],
        "properties": {
          "selectedWork": { "type": "array", "items": { "$ref": "#/components/schemas/WorkItem" } },
          "total": { "type": "integer", "example": 6 },
          "_meta": { "$ref": "#/components/schemas/ApiMeta" }
        }
      },
      "ServiceItem": {
        "type": "object",
        "required": ["id", "name", "description"],
        "properties": {
          "id": { "type": "string", "example": "01" },
          "name": { "type": "string", "example": "Branding" },
          "description": { "type": "string" }
        }
      },
      "ServicesResponse": {
        "type": "object",
        "required": ["services", "total"],
        "properties": {
          "services": { "type": "array", "items": { "$ref": "#/components/schemas/ServiceItem" } },
          "total": { "type": "integer", "example": 6 },
          "_meta": { "$ref": "#/components/schemas/ApiMeta" }
        }
      },
      "ContactInfo": {
        "type": "object",
        "required": ["email", "preferredMethod", "note"],
        "properties": {
          "name": { "type": "string", "example": "Sumukh Singh" },
          "role": { "type": "string", "example": "Creative Strategist & Content Marketer" },
          "email": { "type": "string", "format": "email", "example": "sumukh.workk@gmail.com" },
          "website": { "type": "string", "format": "uri" },
          "location": { "type": "string", "example": "Delhi, India" },
          "preferredMethod": { "type": "string", "example": "Email" },
          "availability": { "type": "string" },
          "note": { "type": "string" }
        }
      },
      "ContactResponse": {
        "type": "object",
        "required": ["contact"],
        "properties": {
          "contact": { "$ref": "#/components/schemas/ContactInfo" },
          "_meta": { "$ref": "#/components/schemas/ApiMeta" }
        }
      },
      "ApiMeta": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "version": { "type": "string" },
          "description": { "type": "string" },
          "apiBase": { "type": "string", "format": "uri" },
          "docs": { "type": "string", "format": "uri" },
          "schema": { "type": "string", "format": "uri" },
          "mcp": { "type": "string", "format": "uri" },
          "llms": { "type": "string", "format": "uri" },
          "deprecationPolicy": { "type": "string", "format": "uri" }
        }
      },
      "PortfolioInfo": {
        "type": "object",
        "required": ["_meta", "person", "skills", "selectedWork", "services", "contact"],
        "properties": {
          "_meta": { "$ref": "#/components/schemas/ApiMeta" },
          "person": { "$ref": "#/components/schemas/PersonInfo" },
          "skills": { "type": "array", "items": { "type": "string" } },
          "selectedWork": { "type": "array", "items": { "$ref": "#/components/schemas/WorkItem" } },
          "services": { "type": "array", "items": { "$ref": "#/components/schemas/ServiceItem" } },
          "contact": { "$ref": "#/components/schemas/ContactInfo" }
        }
      },
      "McpManifest": {
        "type": "object",
        "required": ["mcpVersion", "name", "transport", "url", "resources", "tools"],
        "properties": {
          "mcpVersion": { "type": "string", "example": "2025-03-26" },
          "name": { "type": "string", "example": "Sumukh Singh Portfolio" },
          "description": { "type": "string" },
          "vendor": { "type": "string", "example": "Sumukh Singh" },
          "homepage": { "type": "string", "format": "uri" },
          "contact": { "type": "string", "format": "email" },
          "transport": { "type": "string", "enum": ["streamable-http", "sse"] },
          "url": { "type": "string", "format": "uri" },
          "resources": { "type": "array", "items": { "type": "object" } },
          "tools": { "type": "array", "items": { "type": "object" } }
        }
      },
      "JsonRpcRequest": {
        "type": "object",
        "required": ["jsonrpc", "method"],
        "properties": {
          "jsonrpc": { "type": "string", "enum": ["2.0"] },
          "id": { "oneOf": [{ "type": "string" }, { "type": "integer" }, { "type": "null" }] },
          "method": { "type": "string", "example": "initialize" },
          "params": { "type": "object" }
        }
      },
      "JsonRpcResponse": {
        "type": "object",
        "required": ["jsonrpc", "id"],
        "properties": {
          "jsonrpc": { "type": "string", "enum": ["2.0"] },
          "id": { "oneOf": [{ "type": "string" }, { "type": "integer" }, { "type": "null" }] },
          "result": { "type": "object" },
          "error": { "$ref": "#/components/schemas/JsonRpcError" }
        }
      },
      "JsonRpcError": {
        "type": "object",
        "required": ["code", "message"],
        "properties": {
          "code": { "type": "integer" },
          "message": { "type": "string" },
          "data": { "type": "object" }
        }
      },
      "JsonRpcErrorResponse": {
        "type": "object",
        "required": ["jsonrpc", "id", "error"],
        "properties": {
          "jsonrpc": { "type": "string", "enum": ["2.0"] },
          "id": { "oneOf": [{ "type": "string" }, { "type": "integer" }, { "type": "null" }] },
          "error": { "$ref": "#/components/schemas/JsonRpcError" }
        }
      }
    }
  }
}
