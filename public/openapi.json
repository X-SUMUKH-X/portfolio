                  "type": "string"
                }
              }
            }
          }
        },
        "tags": ["Portfolio"]
      }
    },
    "/creative-strategy.html": {
      "get": {
        "operationId": "getCreativeStrategy",
        "summary": "Creative strategy case study",
        "description": "In-depth creative strategy case study page.",
        "responses": {
          "200": {
            "description": "HTML case study page",
            "content": {
              "text/html": {
                "schema": { "type": "string" }
              }
            }
          }
        },
        "tags": ["Case Studies"]
      }
    },
    "/slack-swiggy-hq.html": {
      "get": {
        "operationId": "getSlackSwiggyCase",
